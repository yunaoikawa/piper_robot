<mujoco model="piper_description">
  <!-- Keep the model self-contained: these meshes are versioned in this repo. -->
  <compiler angle="radian" meshdir="../mjcf/meshes/piper"/>

  <option integrator="implicitfast" cone="elliptic" impratio="10"/>

  <default>
    <default class="piper">
      <joint frictionloss="0.3" armature="0.005"/>
      <position inheritrange="1" forcerange="-100 100"/>
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0" density="0"/>
      </default>
      <default class="collision">
        <geom group="3" type="capsule"/>
      </default>
      <default class="collision_gripper">
        <geom type="mesh" group="3" friction="2 0.005 0.0001" density="100"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="gray_mat" rgba="0.59 0.59 0.59 1"/>
    <material name="light_gray_mat" rgba="0.98 0.98 0.98 1"/>
    <material name="light_medium_gray_mat" rgba="0.85 0.85 0.85 1"/>
    <material name="dark_gray_mat" rgba="0.086 0.086 0.086 1"/>
    <material name="darker_gray_mat" rgba="0.14 0.14 0.14 1"/>
    <material name="white_mat" rgba="1 1 1 1"/>
    <material name="white" rgba="1 1 1 1"/>
    <material name="gray" rgba="0.59 0.59 0.59 1"/>
    <material name="red_mat" rgba="0.82 0.15 0.15 1"/>
    <material name="black_mat" rgba="0 0 0 1"/>
    <material name="light_blue" rgba="0.79 0.82 0.93 1"/>

    <!--
      The upstream Menagerie model split links 2-5 into dozens of material-specific
      OBJ files. Those files are not part of this repository, so use the complete
      single-link STL meshes that are. This loses only per-panel material colours;
      kinematics, inertials, collision proxies, and dimensions stay unchanged.
    -->
    <mesh name="base_link" file="link0.stl"/>
    <mesh name="link1" file="link1.stl"/>
    <mesh name="link2" file="link2.stl"/>
    <mesh name="link3" file="link3.stl"/>
    <mesh name="link4" file="link4.stl"/>
    <mesh name="link5" file="link5.stl"/>
    <mesh name="gripper_body" file="gripper_body.stl" scale="0.001 0.001 0.001"/>
    <mesh name="gripper_housing" file="gripper_housing.stl" scale="0.001 0.001 0.001"/>
    <mesh name="gripper_upper" file="gripper_upper.stl" scale="0.001 0.001 0.001"/>
    <mesh name="gripper_lower" file="gripper_lower.stl" scale="0.001 0.001 0.001"/>
    <mesh name="iphone" file="iphone.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="gripper_base" pos="0 0 1"/>
    <body name="base_link" childclass="piper" gravcomp="1">
      <inertial pos="-0.00979275 1.82906e-06 0.04101" quat="0.692988 -0.137524 -0.137826 0.69416" mass="0.162549"
        diaginertia="0.000269445 0.000227478 0.000221437"/>
      <geom class="visual" density="0" mesh="base_link" material="gray_mat"/>
      <geom class="collision" mesh="base_link"/>
      <body name="link1" pos="0 0 0.123" quat="0.707105 0 0 -0.707108" gravcomp="1">
        <inertial pos="0.00131676 0.000310289 -0.00922875" quat="0.557105 0.432155 0.377373 0.600388" mass="0.097868"
          diaginertia="9.25942e-05 8.3083e-05 7.69469e-05"/>
        <joint name="joint1" axis="0 0 1" range="-2.618 2.618"/>
        <geom class="visual" density="0" mesh="link1" material="gray_mat"/>
        <geom class="collision" mesh="link1"/>
        <body name="link2" quat="0.499998 0.5 -0.500002 -0.5" gravcomp="1">
          <inertial pos="0.148794 -0.00242027 0.00175155" quat="-0.0249063 0.70684 0.00803509 0.706889" mass="0.290889"
            diaginertia="0.00177549 0.00173142 0.00014552"/>
          <joint name="joint2" axis="0 0 1" range="0 3.14"/>
          <geom mesh="link2" material="gray_mat" class="visual"/>
          <geom mesh="link2" class="collision"/>
          <body name="link3" pos="0.28358 0.028726 0" quat="0.998726 0 0 0.0504536" gravcomp="1">
            <inertial pos="-0.0996835 0.0349477 0.000508026" quat="0.0777021 0.702287 -0.0990541 0.700674"
              mass="0.290848" diaginertia="0.000241946 0.000222224 0.000100384"/>
            <joint name="joint3" pos="0 0 0" axis="0 0 1" range="-2.697 0"/>
            <geom mesh="link3" material="gray_mat" class="visual"/>
            <geom mesh="link3" class="collision"/>
            <body name="link4" pos="-0.24221 0.068514 0" quat="0.544767 -0.544769 -0.450809 0.450808" gravcomp="1">
              <inertial pos="0.000276465 -0.00102804 -0.00472831" quat="0.492305 0.505285 0.503294 0.499017"
                mass="0.127087" diaginertia="4.87057e-05 4.10595e-05 3.82001e-05"/>
              <joint name="joint4" axis="0 0 1" range="-1.832 1.832"/>
              <geom mesh="link4" material="gray_mat" class="visual"/>
              <geom mesh="link4" class="collision"/>
              <body name="link5" quat="0.707105 0.707108 0 0" gravcomp="1">
                <inertial pos="8.82262e-05 0.0566829 -0.0019612" quat="0.507447 0.490986 0.506887 0.494466"
                  mass="0.144711" diaginertia="0.001 0.001 0.001"/>
                <joint name="joint5" axis="0 0 1" range="-1.22 1.22"/>
                <geom mesh="link5" material="gray_mat" class="visual"/>
                <geom mesh="link5" class="collision"/>

                <body name="link6_mount" pos="0 0.091 0.0014165" quat="0 0 -0.707105 -0.707108" gravcomp="1">
                  <body name="gripper_base" gravcomp="1">
                    <!-- WetRobo grasp target: midpoint between the finger pads, in gripper_base frame -->
                    <site name="grasp" pos="-0.0288 -0.0183 0.058" size="0.006" rgba="0 1 0 0"/>
                    <body name="gripper" euler="0 0 0" gravcomp="1">
                      <body name="gripper_align" pos="0 0 0" euler="0 1.5708 0" gravcomp="1">
                        <inertial pos="-0.000183807 8.05033e-05 0.0321437"
                          quat="0.999976 9.08444e-05 0.00689649 0.000788512"
                          mass="0.45"
                          diaginertia="0.000929442 0.000714469 0.000394318"/>
                        <!-- Fixed housing -->
                        <geom mesh="gripper_housing" class="visual" material="light_blue" euler="3.14159265359 0 0"/>
                        <geom mesh="gripper_housing" class="collision_gripper" euler="3.14159265359 0 0"/>

                        <!-- Upper blade (opens in +rot) -->
                        <body name="upper_jaw" pos="-0.0308 -0.0051 -0.0302" gravcomp="1">
                          <joint name="upper_jaw_joint" type="hinge" axis="0 0 1" range="0 0.99" ref="0.66" damping="2" stiffness="50" springref="0" frictionloss="0.5" armature="0.01"/>
                          <!-- Sponge contact patch on the inner face of the upper jaw (WetRobo
                               grasp gate: only this pad grips). Moves apart/together with the jaw. -->
                          <site name="pad_upper" pos="-0.0230 -0.0172 0.0014" size="0.005" rgba="1 0.5 0 0"/>
                          <geom mesh="gripper_upper" class="visual" material="light_blue"
                                euler="3.14159265359 0 0" pos="0.0308 0.0051 0.0302"/>
                          <geom mesh="gripper_upper" class="collision_gripper"
                                euler="3.14159265359 0 0" pos="0.0308 0.0051 0.0302"/>
                        </body>

                        <!-- Lower blade (opens in -rot, coupled to upper) -->
                        <body name="lower_jaw" pos="-0.0314 -0.0321 -0.0275" gravcomp="1">
                          <joint name="lower_jaw_joint" type="hinge" axis="0 0 1" range="-0.99 0" ref="-0.66" damping="2" stiffness="50" springref="0" frictionloss="0.5" armature="0.01"/>
                          <!-- Sponge contact patch on the inner face of the lower jaw. -->
                          <site name="pad_lower" pos="-0.0230 0.0165 -0.0013" size="0.005" rgba="1 0.5 0 0"/>
                          <geom mesh="gripper_lower" class="visual" material="light_blue"
                                euler="3.14159265359 0 0" pos="0.0314 0.0321 0.0275"/>
                          <geom mesh="gripper_lower" class="collision_gripper"
                                euler="3.14159265359 0 0" pos="0.0314 0.0321 0.0275"/>
                        </body>

                        <body name="iphone_body" pos="-0.0075 -0.015 -0.017" euler="3.14159265359 0 1.5708" gravcomp="1">
                          <geom mesh="iphone" class="visual" material="gray"/>
                          <geom mesh="iphone" class="collision"/>
                          <body name="camera_body" pos="0.0 -0.036 0.1"
                            euler="-0.2617993878 3.14159265359 0.0" gravcomp="1">
                            <site name="ee" pos="0.0 0.0 0.0"/>
                            <geom type="box" size="0.01 0.01 0.01" rgba="0.1 0.5 0.1 0" contype="0" conaffinity="0"/>
                            <camera name="egocentric" mode="fixed" fovy="53.1"/>
                          </body>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="base_link" body2="link1"/>
  </contact>

  <equality>
    <joint joint1="upper_jaw_joint" joint2="lower_jaw_joint" polycoef="0 -1 0 0 0"/>
  </equality>

  <actuator>
    <position name="joint1" joint="joint1" class="piper" kp="80" kv="5"/>
    <position name="joint2" joint="joint2" class="piper" kp="80" kv="5"/>
    <position name="joint3" joint="joint3" class="piper" kp="80" kv="5"/>
    <position name="joint4" joint="joint4" class="piper" kp="40" kv="5"/>
    <position name="joint5" joint="joint5" class="piper" kp="10" kv="1.5"/>
    <position name="gripper" joint="upper_jaw_joint" class="piper" kp="100" kv="10"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0 1.57 -1.3485 0 0 0.99 -0.99" ctrl="0 1.57 -1.3485 0 0 0.99"/>
  </keyframe>
</mujoco>
